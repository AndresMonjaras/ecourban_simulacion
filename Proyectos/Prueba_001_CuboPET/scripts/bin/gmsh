#!/usr/bin/env bash
# Ejecuta Gmsh desde el AppImage de FreeCAD.
set -uo pipefail
APPIMAGE="/mnt/BancaPET/Aplicaciones/FreeCAD/FreeCAD_1.1.4-Linux-x86_64-py311.AppImage"

if [[ ! -x "${APPIMAGE}" ]]; then
    echo "No se encontró el AppImage de FreeCAD: ${APPIMAGE}" >&2
    exit 127
fi

exec "${APPIMAGE}" gmsh "$@"
